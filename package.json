{
  "name": "relaykit",
  "private": true,
  "version": "1.0.0",
  "description": "Microservices architecture demo: a gateway relaying requests to specialist services.",
  "workspaces": [
    "services/*",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:unit": "npm run test --workspaces --if-present",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "test": "npm run test:unit && npm run test:integration",
    "dev:gateway": "npm run dev -w services/gateway",
    "dev:stats": "npm run dev -w services/stats-service",
    "dev:lang": "npm run dev -w services/lang-service",
    "dev:keyword": "npm run dev -w services/keyword-service",
    "dev:frontend": "npm run dev -w frontend"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.1.11",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "tsx": "^4.19.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
